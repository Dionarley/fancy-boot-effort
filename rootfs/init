#!/busybox sh
# Montar sistemas de arquivos essenciais
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

# Estética Fancy
clear
echo -e "\033[1;36m"
cat << "EOF"
    ____  ______  ____  ______
   / __ )/ __ \/ __ \/_  __/
  / __  / / / / / / / / /   
 / /_/ / /_/ / /_/ / / /    
/_____/\____/\____/ /_/     
EOF
echo -e "\033[0m"
echo "Detectando Hardware..."
sleep 1
grep "model name" /proc/cpuinfo | head -1
echo -e "\nIniciando interface de usuário minimalista..."
sleep 2

# No QEMU, podemos abrir um shell direto
exec /bin/sh
