#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
KERNEL_IMAGE=${KERNEL_IMAGE:-${1:-/boot/vmlinuz-linux}}
INITRAMFS_IMAGE=${INITRAMFS_IMAGE:-${SCRIPT_DIR}/initramfs.cpio.gz}
RAM_MB=${RAM_MB:-512}

if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
  echo "❌ qemu-system-x86_64 não encontrado no ambiente." >&2
  echo "   Instale o pacote qemu-system-x86 para testar boot localmente." >&2
  exit 1
fi

if [[ ! -f "${KERNEL_IMAGE}" ]]; then
  echo "❌ Kernel não encontrado: ${KERNEL_IMAGE}" >&2
  echo "   Dica: exporte KERNEL_IMAGE=/caminho/do/vmlinuz antes de executar." >&2
  exit 1
fi

if [[ ! -f "${INITRAMFS_IMAGE}" ]]; then
  echo "❌ initramfs não encontrado: ${INITRAMFS_IMAGE}" >&2
  echo "   Execute ./build.sh antes de iniciar o QEMU." >&2
  exit 1
fi

exec qemu-system-x86_64 \
  -m "${RAM_MB}M" \
  -kernel "${KERNEL_IMAGE}" \
  -initrd "${INITRAMFS_IMAGE}" \
  -append "console=ttyS0 rdinit=/init" \
  -nographic \
  -no-reboot
